{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "packageRules": [
    {
      "description": "Patch updates merge themselves once CI is green",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "The exporter pins the exact versions the published checkpoints were validated with",
      "matchPackageNames": ["rfdetr", "torch", "transformers"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Intel GPU runtime for the OpenVINO image",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG COMPUTE_RUNTIME_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "intel/compute-runtime",
      "datasourceTemplate": "github-releases"
    }
  ]
}
