# Hugging Face read token from an account that accepted the DINOv3 license
# (https://huggingface.co/facebook/dinov3-vits16-pretrain-lvd1689m). Only the exporter uses it.
HF_TOKEN=

# One Immich API key per user who owns photos, as name=key pairs separated by commas.
# Users who only see shared albums don't need a key.
API_KEYS=alice=xxxxxxxx,bob=yyyyyyyy

# Only needed if Immich isn't reachable as immich-server on the shared Docker network.
# IMMICH_URL=http://192.168.1.10:2283

TZ=Europe/Stockholm
